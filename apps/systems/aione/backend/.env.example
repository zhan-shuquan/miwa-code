# Local / TCP example
DB_USER=aione_app
DB_PASS=REPLACE_ME
DB_NAME=aione
DB_HOST=127.0.0.1
DB_PORT=5432

# Cloud Run + Cloud SQL Unix socket example
# INSTANCE_UNIX_SOCKET=/cloudsql/PROJECT_ID:asia-northeast1:INSTANCE_NAME

# Optional single connection string
# DATABASE_URL=postgresql://user:password@host:5432/aione

# Only for local/internal preview actor headers. Keep false in production.
AIONE_ALLOW_PREVIEW_ACTOR=false
AIONE_ALLOW_SYSTEM_WRITES=false

# Production Google identity verification.
# The Client ID is public; never place a Google Client Secret in the frontend.
AIONE_REQUIRE_GOOGLE_AUTH=false
AIONE_GOOGLE_CLIENT_ID=
PORT=8080

# AIONE Model Provider Layer
# preview = deterministic plumbing verification
# live    = use AIONE_AI_PROVIDER through the backend-only provider layer
AIONE_AI_MODE=preview
AIONE_AI_PROVIDER=openai
AIONE_AI_MODEL=gpt-5.6-sol

# OpenAI is the first live provider. Keep this secret ONLY on Backend / Secret Manager.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Static Preview (:5500) -> Backend (:8080)
AIONE_CORS_ORIGINS=https://aione.miwa-happyhouse.com,http://127.0.0.1:5500,http://localhost:5500

# 1688 Open Platform product-source integration
# Enterprise self-use application: AppKey + AppSecret + permanent authorized Access Token.
# Secrets stay backend-only. In production use Secret Manager.
ALIBABA_1688_APP_KEY=
ALIBABA_1688_APP_SECRET=
ALIBABA_1688_ACCESS_TOKEN=
# static = use the permanent token from 开发指引 -> 授权配置 -> 已授权Token.
ALIBABA_1688_TOKEN_MODE=static
# Optional legacy/fallback token fields; not used by the normal enterprise self-use path.
ALIBABA_1688_REFRESH_TOKEN=
ALIBABA_1688_API_BASE=https://gw.open.1688.com/openapi
ALIBABA_1688_TOKEN_URL=https://gw.open.1688.com/openapi/param2/1/system.oauth2/getToken
ALIBABA_1688_AUTHORIZE_URL=https://auth.1688.com/oauth/authorize
# OAuth callback is retained only as a fallback/debug path; normal enterprise self-use does not use it.
ALIBABA_1688_REDIRECT_URI=http://127.0.0.1:8080/api/v1/integrations/1688/oauth/callback
# Default: official cross-border product detail API descriptor.
ALIBABA_1688_PRODUCT_API=com.alibaba.product:alibaba.cross.productInfo-1

# Google Drive secure asset proxy
# Production Cloud Run uses Application Default Credentials from the runtime service account.
# Add that runtime service account as Viewer of the shared drive "美和集团（全球）" once.
AIONE_DRIVE_PROXY_ENABLED=true
