# Copy to cloud-config.sh only if auto-discovery cannot determine your existing AIONE settings.
# Never place actual passwords or API keys in this file.

export AIONE_REGION="asia-northeast1"
export AIONE_SOURCE_RUN_SERVICE="aione-backend"
export AIONE_RUN_SERVICE="aione-backend-v190"
export AIONE_ARTIFACT_REPO="aione"
export AIONE_IMAGE_NAME="aione-backend"
export AIONE_PREFLIGHT_JOB="aione-db-preflight"
export AIONE_MIGRATION_JOB="aione-db-migrate"
export AIONE_RUNTIME_SERVICE_ACCOUNT_NAME="aione-runtime"

# Normally auto-detected from the existing Cloud Run service / Cloud SQL project.
export AIONE_SQL_INSTANCE=""
export AIONE_DB_NAME="aione"
export AIONE_DB_USER="aione_app"
export AIONE_DB_PASSWORD_SECRET=""

# Keep the first real Cloud Run deployment in deterministic Preview mode.
export AIONE_AI_MODE="preview"
